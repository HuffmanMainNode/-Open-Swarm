{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HuffmanMainNode/-Open-Swarm/blob/main/schemas/platform-event.schema.json",
  "title": "Huffman Open Intelligence Platform Event v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "source",
    "classification",
    "payload",
    "evidence_refs",
    "correlation_id",
    "causation_id"
  ],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$",
      "maxLength": 128
    },
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1, "maxLength": 128 },
    "classification": { "enum": ["public", "internal", "restricted"] },
    "payload": { "type": "object" },
    "evidence_refs": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "correlation_id": { "type": ["string", "null"], "maxLength": 128 },
    "causation_id": { "type": ["string", "null"], "maxLength": 128 }
  }
}
